generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String       @id          @default(uuid())
  username         String       @unique
  password         String
  balance          Int?      @default(0)

  markets          Market[]
  bets             Bet[]
  transactions     WalletEvent[]
}

model Market {
  id              String       @id         @default(uuid())
  title           String
  initialWager    Int?        @default(0)
  creator_id      String
  bet             Side
  resolution      Resolution  @default(pending)

  user            User        @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  bets            Bet[]
}

enum Side {
  yes
  no
}
enum Resolution {
  resolved
  pending
}

model Bet {
  id            String      @id                 @default(uuid())
  user_id       String
  market_id     String
  bet_amount    Int

  user          User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  market        Market      @relation(fields: [market_id], references: [id], onDelete: Cascade)
}

model WalletEvent {
  id                  String      @id                 @default(uuid())
  user_id             String
  transaction_type    String
  transaction_amount  Int
  meta_data           Json?       @default("{}")

  user                User        @relation(fields: [user_id], references: [id])
}
